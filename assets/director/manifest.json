{
  "schemaVersion": 1,
  "coordinates": {
    "unit": "source-pixels",
    "origin": "top-left",
    "x": "right",
    "y": "down",
    "bounds": "[left, top, rightExclusive, bottomExclusive]",
    "points": "[x, y]; divide x by width and y by height to normalize"
  },
  "measurements": {
    "alphaThresholds": {
      "nonzero": 1,
      "halfOpacity": 128,
      "nearOpaque": 250
    },
    "contentBounds": "Half-opacity mask bounds for actors; full image bounds for opaque backgrounds and cards.",
    "source": "Decoded PNG pixels and SHA-256 of the unmodified file bytes."
  },
  "anchorPolicy": {
    "status": "provisional",
    "ready": "ground is the projected midpoint of two visually estimated boot contacts; it is not a collision or ball-contact point.",
    "kick": "ground marks the planted boot; kickContact separately marks the raised striking boot. Neither is the ball center. Do not replace either with an alpha bounding-box corner.",
    "dive": "Airborne poses intentionally have no ground anchor. Use bodyPivot for the body and groundProjection only as a low-confidence placement assumption; gloveContact and supportingGloveContact mark the two palms.",
    "collision": "Alpha bounds describe visible coverage only. Neither bounds nor the provisional anchors validate foot-ball, hand-ball, or turf contact.",
    "mirroring": "Facing describes the source image before any horizontal reflection. Reflect anchor x with width - x when drawing the image mirrored.",
    "run": "ground is a projection below the pelvis for scene placement; supportContact is a separate provisional boot reference, not a guarantee that the depicted stride touches turf.",
    "poseChange": "Pose anchors have different meanings. Changing from ready to kick or dive requires an explicit placement transition; matching the image rectangle or bottom pixel is not contact validation."
  },
  "notes": [
    "All 25 supplied PNGs were decoded and visually inspected. The manifest records file measurements, not runtime compositing approval.",
    "Actor files contain broad, low-alpha colored halos. nonzeroBounds must not define anatomical height or a foot contact.",
    "All current actor files have alpha maxima of 254, so alpha == 255 would incorrectly find no solid body.",
    "Card illustrations contain painted balls and players; they are card art, not layers for the live match.",
    "Background variants have different crowd appearances; see production-notes.md before intercutting them.",
    "No PNG was resized, cropped, recolored, or otherwise modified during measurement."
  ],
